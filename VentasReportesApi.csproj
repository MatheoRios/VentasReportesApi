<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VentasReportesApi</RootNamespace>
    <AssemblyName>VentasReportesApi</AssemblyName>
    <Version>1.32.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefaultItemExcludes>$(DefaultItemExcludes);VentasReportesApi.Tests\**;scripts\**;docs\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VentasReportesApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="sucursales.json" />
    <None Remove="sucursales.json" />
    <Content Remove="tiendas-instancias.config" />
    <None Remove="tiendas-instancias.config" />
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="iniciar-api.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Update="admin.bat" CopyToOutputDirectory="PreserveNewest" />
    <!-- app web (teléfono / tablet / PC): se sirve en /app -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
